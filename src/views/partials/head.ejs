<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= titulo %> | Fressia Indumentaria</title>
  <meta name="description" content="<%= locals.descripcion || 'Fressia Indumentaria: tops, vestidos, jeans, blusas y accesorios. Moda que te acompaña. Envíos a todo el país.' %>">
  <meta name="theme-color" content="#f6efe7">
  <meta property="og:title" content="<%= titulo %> | Fressia Indumentaria">
  <meta property="og:type" content="website">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# Gloock + Great Vibes: el logo · Cormorant Garamond: títulos · Jost: textos %>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Gloock&family=Great+Vibes&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <% const esPanel = [].concat(locals.estilo || []).includes('admin'); %>
  <%# Panel: Inter, con números parejos y fáciles de leer %>
  <% if (esPanel) { %><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><% } %>

  <link rel="stylesheet" href="/css/base.css">
  <%# estilo puede ser un nombre o una lista: "login" o ["cuenta", "mis-datos"] %>
  <% [].concat(locals.estilo || []).forEach(hoja => { %>
    <link rel="stylesheet" href="/css/<%= hoja %>.css">
  <% }) %>
</head>
<body class="<%= locals.claseBody || '' %><%= esPanel ? ' adm-body' : '' %>">
